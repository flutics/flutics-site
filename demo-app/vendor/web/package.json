{
  "name": "meadow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-toolchain.mjs",
    "build:shell": "vite build",
    "build:toolchain": "node scripts/build-toolchain.mjs",
    "test:navclick": "node --test --experimental-strip-types src/navclick.test.ts",
    "test:shellfile": "node --test --experimental-strip-types src/shellfile.test.ts",
    "test:sso-domains": "node --test --experimental-strip-types src/ssoDomains.test.ts",
    "test:appchrome": "node --test --experimental-strip-types src/appchrome.test.ts",
    "test:settings-registry": "node --test --experimental-strip-types src/settings/registry.test.ts",
    "test:settings-router": "node --test --experimental-strip-types src/settings/router.test.ts",
    "test:api": "node --test --experimental-strip-types src/api.test.ts",
    "test:snowflake-conn": "node --test --experimental-strip-types src/snowflakeConn.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && npx eslint --config web/eslint.config.js web/src",
    "check:frontend": "npm run typecheck && npm run lint",
    "test:e2e": "playwright test",
    "test:site": "playwright test -c playwright.site.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.26.0",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.3.5"
  }
}
