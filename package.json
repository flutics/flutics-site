{
  "name": "flutics-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "npm --prefix demo-app install && npm --prefix demo-app run dev",
    "build": "npm run build:www",
    "build:www": "tsc --noEmit && vite build && npm run build:demo && node scripts/add-demo.mjs",
    "build:demo": "npm --prefix demo-app install && npm --prefix demo-app run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:demo": "npm --prefix demo-app run preview",
    "test": "node --test scripts/add-demo.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
