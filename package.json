{
  "name": "flutics-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --config vite.demo.config.ts --port 5174",
    "build": "npm run build:www && npm run build:demo",
    "build:www": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:demo": "vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
